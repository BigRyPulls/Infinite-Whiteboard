{
  "name": "infinite-whiteboard",
  "version": "0.1.0",
  "description": "Personal WIP: a local-first infinite whiteboard for drawing, sketches and waypoint-based navigation.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/print-lan.js dev && vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/print-lan.js serve && node server/server.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "express": "^4.21.1"
  }
}
